WORKTRACE_LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
WORKTRACE_LLM_MODEL=your-model-name
WORKTRACE_LLM_API_KEY=your-api-key
# Request timeout in seconds
WORKTRACE_LLM_TIMEOUT_SECONDS=1200
# Enable streaming explicitly when the provider supports streamed Function calls
WORKTRACE_LLM_STREAM=false
# Optional: verify HTTPS certificates
# WORKTRACE_LLM_TLS_VERIFY=false
# Online fallback requires the effective value to remain none; this matches the built-in default
WORKTRACE_LLM_REASONING_EFFORT=none
# Online wire protocol: responses (default) or chat_completions
WORKTRACE_LLM_WIRE_API=responses

# Required Codex primary route settings. These values are read only from this repository-local file.
WORKTRACE_CODEX_MODEL=your-codex-model-name
WORKTRACE_CODEX_REASONING_EFFORT=your-model-supported-effort
# Required Codex relay definition. Keep the relay Key in Codex's own credential storage.
WORKTRACE_CODEX_PROVIDER_ID=your-relay-id
WORKTRACE_CODEX_PROVIDER_NAME=your-relay-name
WORKTRACE_CODEX_PROVIDER_BASE_URL=https://your-relay.example/v1
WORKTRACE_CODEX_PROVIDER_WIRE_API=responses
WORKTRACE_CODEX_PROVIDER_REQUIRES_OPENAI_AUTH=true
