# Model mode: codex_with_fallback (default) or online_only.
# Process environment variables override this file.
WORKTRACE_LLM_MODE=codex_with_fallback
# WORKTRACE_LLM_MODE=online_only
# Online connection: required in online_only; optional fallback otherwise.
WORKTRACE_LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
WORKTRACE_LLM_MODEL=your-model-name
WORKTRACE_LLM_API_KEY=your-api-key
# Request timeout in seconds
WORKTRACE_LLM_TIMEOUT_SECONDS=1200
# Enable streaming explicitly when the provider supports streamed Function calls
WORKTRACE_LLM_STREAM=false
# HTTPS certificate verification defaults to false for existing internal deployments.
# false means the certificate trust chain is NOT verified. Enable true with a trusted certificate chain.
# WORKTRACE_LLM_TLS_VERIFY=false
# Online requires the effective value to remain none; this matches the built-in default
WORKTRACE_LLM_REASONING_EFFORT=none
# Online wire protocol: responses (default) or chat_completions for /chat/completions providers
WORKTRACE_LLM_WIRE_API=responses

# Required only in codex_with_fallback. Ignored in online_only. These values are read only from this repository-local file.
# Fill manually or use import-codex-config --apply; blank fields allow explicit import.
WORKTRACE_CODEX_MODEL=
WORKTRACE_CODEX_REASONING_EFFORT=
# Codex relay definition for codex_with_fallback. Keep the relay Key in Codex's own credential storage.
WORKTRACE_CODEX_PROVIDER_ID=
WORKTRACE_CODEX_PROVIDER_NAME=
WORKTRACE_CODEX_PROVIDER_BASE_URL=
WORKTRACE_CODEX_PROVIDER_WIRE_API=
# true selects Codex's auth storage; false is suitable only when the relay needs no inherited auth.
WORKTRACE_CODEX_PROVIDER_REQUIRES_OPENAI_AUTH=
