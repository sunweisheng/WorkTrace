  "error_categories": [
    {"key": "missing_config", "patterns": ["missing online llm configuration", "requires worktrace_llm"]},
    {"key": "command_missing", "patterns": ["required command not found", "command not found"]},
    {"key": "authentication", "patterns": ["not logged in", "authentication", "invalid api key", "auth status"]},
    {"key": "permission", "patterns": ["permission", "http 403"]},
    {"key": "timeout", "patterns": ["timed out", "timeout"]},
    {"key": "network", "patterns": ["network", "connection", "unreachable", "service unavailable"]},
    {"key": "rate_limited", "patterns": ["rate limit", "http 429"]},
    {"key": "invalid_protocol", "patterns": ["invalid json", "did not return valid json", "invalid protocol", "codex json event stream", "codex output is empty", "function call", "function arguments", "called an unexpected function", "personal event final review", "personal-group-render", "self action evidence"]},
    {"key": "storage", "patterns": ["write", "output file is missing"]},
    {"key": "delivery", "patterns": ["deliver", "send", "送达"]}
  ],
  "privacy_patterns": [
    {"key": "feishu_id", "pattern": "\\b(?:oc|ou|om|on)_[A-Za-z0-9]+\\b"},
    {"key": "secret", "pattern": "\\b(?:sk|wt)_[A-Za-z0-9_-]{8,}\\b"},
    {"key": "url", "pattern": "https?://"},
    {"key": "email", "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"},
    {"key": "phone", "pattern": "(?<!\\d)1[3-9]\\d{9}(?!\\d)"},
    {"key": "user_directory", "pattern": "(?:/Users/|/home/)[^/\\s]+"},
    {"key": "windows_user_directory", "pattern": "[A-Za-z]:\\\\Users\\\\[^\\\\\\s]+"},
    {"key": "date", "pattern": "\\b\\d{4}-\\d{2}-\\d{2}\\b"},
    {"key": "dated_text", "pattern": "\\b\\d{4}[年/]\\d{1,2}[月/]\\d{1,2}日?\\b"},
    {"key": "debug_filename", "pattern": "\\b[^\\s/\\\\]+\\.(?:md|json|log|txt|zip)\\b"}
  ]
}
