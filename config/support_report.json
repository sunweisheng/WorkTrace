{
  "schema_version": 1,
  "function": {
    "name": "submit_worktrace_support_analysis",
    "description": "根据编号诊断事实提交 WorkTrace 问题分析，不得补充事实中没有的信息。"
  },
  "analysis_rules": [
    "只能引用输入中的诊断事实编号，每个问题至少引用一个编号。",
    "只能选择 Function 定义允许的判断、分类、严重程度、原因、检查建议和产品建议编号。",
    "不得补充输入中没有的人名、日期、数字、业务内容、配置内容或运行环境细节。",
    "所有计算已经由 Python 完成，不得重新计算或改写诊断事实中的数字。"
  ],
  "llm_validation_retry_limit": 1,
  "slow_stage_min_share": 0.25,
  "slow_stage_limit": 5,
  "max_findings": 6,
  "safe_text": {
    "title": "WorkTrace 调试诊断报告",
    "privacy_summary": "已通过外发隐私检查。本报告只包含固定状态、版本号、编号诊断事实和 Python 计算结果。",
    "share_notice": "只分享这一份报告，不要分享原始调试目录或运行日志。",
    "llm_failure": "大模型整理失败。下面仍保留 Python 生成的基础诊断事实，可用于说明本次环境或模型故障。",
    "no_stage_data": "没有可用的分阶段记录。",
    "no_findings": "大模型未返回可用的问题分析。",
    "unknown": "unknown"
  },
