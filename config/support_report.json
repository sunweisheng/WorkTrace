    "severities": [
      {"key": "info", "label": "提示"},
      {"key": "low", "label": "较低"},
      {"key": "medium", "label": "中等"},
      {"key": "high", "label": "较高"}
    ],
    "possible_causes": [
      {"key": "no_issue_detected", "label": "现有诊断事实没有显示明确故障。"},
      {"key": "preflight_failed", "label": "运行前环境检查没有通过。"},
      {"key": "runtime_failed", "label": "正式运行过程没有完成。"},
      {"key": "warnings_present", "label": "任务完成，但运行过程中记录了警告。"},
      {"key": "slow_stage", "label": "主要等待时间集中在少数阶段。"},
      {"key": "model_retry", "label": "模型请求出现失败尝试并触发重试。"},
      {"key": "model_fallback", "label": "在线线路未完成当前请求，使用了备用线路。"},
      {"key": "model_failure", "label": "存在未成功完成的模型请求。"},
      {"key": "output_missing", "label": "正式 Markdown 没有写入。"},
      {"key": "delivery_failed", "label": "本地结果已处理，但送达没有成功。"},
      {"key": "environment_issue", "label": "本机工具、登录状态或模型配置可能不完整。"}
    ],
    "user_checks": [
      {"key": "no_action", "label": "当前无需额外处理。"},
      {"key": "check_local_setup", "label": "请让 Codex 检查本机必要工具、登录状态和本地模型配置。"},
      {"key": "retry_network", "label": "请在网络稳定后再次使用调试模式运行。"},
      {"key": "review_stage", "label": "请重点查看报告中耗时占比较高的阶段。"},
      {"key": "review_output", "label": "请确认正式 Markdown 是否生成，以及内容是否符合预期。"},
      {"key": "retry_delivery", "label": "请保留本地 Markdown，并让 Codex 单独重试本人送达。"},
      {"key": "send_report", "label": "请只发送本报告给维护人员，不要发送原始调试目录。"}
    ],
    "product_suggestions": [
      {"key": "none", "label": "暂时不需要产品改动。"},
      {"key": "improve_preflight", "label": "继续改善运行前检查和面向普通用户的修复提示。"},
      {"key": "improve_retry_visibility", "label": "继续提高模型重试与备用线路状态的可见性。"},
      {"key": "improve_stage_timing", "label": "继续细化阶段耗时记录和慢速阶段提示。"},
      {"key": "improve_output_validation", "label": "继续增强结果生成与完整性检查。"},
      {"key": "improve_delivery_recovery", "label": "继续增强送达失败后的单独恢复能力。"}
    ]
  },
  "error_categories": [
    {"key": "missing_config", "patterns": ["missing online llm configuration", "requires worktrace_llm"]},
    {"key": "command_missing", "patterns": ["required command not found", "command not found"]},
    {"key": "authentication", "patterns": ["not logged in", "authentication", "invalid api key", "auth status"]},
    {"key": "permission", "patterns": ["permission", "http 403"]},
    {"key": "timeout", "patterns": ["timed out", "timeout"]},
    {"key": "network", "patterns": ["network", "connection", "unreachable", "service unavailable"]},
    {"key": "rate_limited", "patterns": ["rate limit", "http 429"]},
    {"key": "invalid_protocol", "patterns": ["invalid json", "invalid protocol", "function calling"]},
    {"key": "storage", "patterns": ["write", "output file is missing"]},
    {"key": "delivery", "patterns": ["deliver", "send", "送达"]}
  ],
  "privacy_patterns": [
    {"key": "feishu_id", "pattern": "\\b(?:oc|ou|om|on)_[A-Za-z0-9]+\\b"},
    {"key": "secret", "pattern": "\\b(?:sk|wt)_[A-Za-z0-9_-]{8,}\\b"},
    {"key": "url", "pattern": "https?://"},
    {"key": "email", "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"},
    {"key": "phone", "pattern": "(?<!\\d)1[3-9]\\d{9}(?!\\d)"},
    {"key": "user_directory", "pattern": "(?:/Users/|/home/)[^/\\s]+"},
    {"key": "windows_user_directory", "pattern": "[A-Za-z]:\\\\Users\\\\[^\\\\\\s]+"},
    {"key": "date", "pattern": "\\b\\d{4}-\\d{2}-\\d{2}\\b"},
    {"key": "dated_text", "pattern": "\\b\\d{4}[年/]\\d{1,2}[月/]\\d{1,2}日?\\b"},
    {"key": "debug_filename", "pattern": "\\b[^\\s/\\\\]+\\.(?:md|json|log|txt|zip)\\b"}
  ]
}
