  "definitions": {
    "overall_assessments": [
      {"key": "healthy", "label": "运行正常"},
      {"key": "needs_attention", "label": "需要关注"},
      {"key": "blocked", "label": "运行受阻"}
    ],
    "problem_categories": [
      {"key": "none", "label": "未发现明确问题"},
      {"key": "startup", "label": "启动与环境"},
      {"key": "runtime", "label": "运行失败"},
      {"key": "performance", "label": "运行速度"},
