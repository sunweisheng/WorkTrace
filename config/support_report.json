      {"key": "none", "label": "暂时不需要产品改动。"},
      {"key": "improve_preflight", "label": "继续改善运行前检查和面向普通用户的修复提示。"},
      {"key": "improve_retry_visibility", "label": "继续提高模型重试与备用线路状态的可见性。"},
      {"key": "improve_stage_timing", "label": "继续细化阶段耗时记录和慢速阶段提示。"},
      {"key": "improve_output_validation", "label": "继续增强结果生成与完整性检查。"},
      {"key": "improve_delivery_recovery", "label": "继续增强送达失败后的单独恢复能力。"}
    ]
